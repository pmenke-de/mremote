# systemd user unit for Linux/X11.
# Install: cp contrib/mremote.service ~/.config/systemd/user/
#          echo "MREMOTE_TOKEN=$(openssl rand -hex 12)" > ~/.config/mremote.env
#          systemctl --user enable --now mremote
[Unit]
Description=mremote – iPhone trackpad and keyboard
After=network-online.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/mremote.env
WorkingDirectory=%h/mremote
ExecStart=/usr/bin/env uv run --script %h/mremote/mremote.py --port 8765
# Retries until the X session is up after boot
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
